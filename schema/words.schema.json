{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinloesethjensen/jp-verb-conjugation-app/main/schema/words.schema.json",
  "title": "Words",
  "description": "data/words.json: adjectives and nouns; forms are generated by update_data.py.",
  "type": "object",
  "required": [
    "version",
    "description",
    "words"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    }
  },
  "$defs": {
    "jlpt": {
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1"
      ]
    },
    "word": {
      "type": "object",
      "required": [
        "class",
        "dict",
        "meaning",
        "jlpt",
        "forms"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "i-adjective",
            "na-adjective",
            "noun"
          ]
        },
        "dict": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "jlpt": {
          "$ref": "#/$defs/jlpt"
        },
        "forms": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]+(_[a-z]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "kanji": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "$ref": "#/$defs/reviewStamp"
        }
      }
    },
    "reviewStamp": {
      "type": "object",
      "required": [
        "by",
        "on",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "owner",
            "teacher",
            "native"
          ]
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
