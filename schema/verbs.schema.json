{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinloesethjensen/jp-verb-conjugation-app/main/schema/verbs.schema.json",
  "title": "Verbs",
  "description": "data/verbs.json: the verbs, their forms (generated by update_data.py) and example sentences.",
  "type": "object",
  "required": [
    "version",
    "description",
    "verbs"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "verbs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verb"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "jlpt": {
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-km-np-z2-9]{6}$"
    },
    "example": {
      "type": "object",
      "required": [
        "id",
        "form",
        "jp",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "form": {
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)*$"
        },
        "jp": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "particle_blanks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/particleBlank"
          }
        },
        "review": {
          "$ref": "#/$defs/reviewStamp"
        }
      }
    },
    "particleBlank": {
      "type": "object",
      "required": [
        "particle",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "particle": {
          "enum": [
            "は",
            "が",
            "を",
            "に",
            "で",
            "へ",
            "と",
            "も",
            "から",
            "まで",
            "の",
            "や",
            "より",
            "か"
          ]
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "accept_also": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "は",
              "が",
              "を",
              "に",
              "で",
              "へ",
              "と",
              "も",
              "から",
              "まで",
              "の",
              "や",
              "より",
              "か"
            ]
          }
        }
      }
    },
    "collocation": {
      "type": "object",
      "required": [
        "id",
        "jp",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "jp": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pair": {
      "type": "object",
      "required": [
        "verb",
        "transitivity",
        "jp",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "verb": {
          "type": "string",
          "minLength": 1,
          "description": "The partner verb's id."
        },
        "transitivity": {
          "enum": [
            "transitive",
            "intransitive"
          ],
          "description": "This verb's half: transitive takes を, intransitive が."
        },
        "jp": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verb": {
      "type": "object",
      "required": [
        "type",
        "label",
        "dict",
        "meaning",
        "description",
        "notes",
        "jlpt",
        "forms",
        "examples"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ru",
            "u",
            "irr."
          ]
        },
        "label": {
          "enum": [
            "Ru-verb",
            "U-verb",
            "Irregular"
          ]
        },
        "dict": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "jlpt": {
          "$ref": "#/$defs/jlpt"
        },
        "forms": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]+(_[a-z]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "collocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/collocation"
          }
        },
        "pair": {
          "$ref": "#/$defs/pair"
        },
        "id": {
          "type": "string",
          "pattern": "^[^:]+:[^:]+$"
        },
        "kanji": {
          "type": [
            "string",
            "null"
          ]
        },
        "teGroup": {
          "enum": [
            "ide",
            "ite",
            "nde",
            "shite",
            "tte"
          ]
        },
        "review": {
          "$ref": "#/$defs/reviewStamp"
        }
      }
    },
    "reviewStamp": {
      "type": "object",
      "required": [
        "by",
        "on",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "owner",
            "teacher",
            "native"
          ]
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
