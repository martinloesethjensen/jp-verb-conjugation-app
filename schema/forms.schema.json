{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinloesethjensen/jp-verb-conjugation-app/main/schema/forms.schema.json",
  "title": "Form catalogue",
  "description": "data/forms.json: the conjugation forms, generated by update_data.py from scripts/form_catalogue.py.",
  "type": "object",
  "required": [
    "schema",
    "description",
    "word_classes",
    "families",
    "forms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "word_classes": {
      "type": "array",
      "items": {
        "enum": [
          "verb",
          "i-adjective",
          "na-adjective",
          "noun"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/form"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "form": {
      "type": "object",
      "required": [
        "id",
        "family",
        "label",
        "role",
        "applies_to",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)*$"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "connective",
            "derived",
            "finite"
          ]
        },
        "applies_to": {
          "type": "array",
          "items": {
            "enum": [
              "verb",
              "i-adjective",
              "na-adjective",
              "noun"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "enum": [
            "authored",
            "derived"
          ]
        },
        "register": {
          "enum": [
            "casual",
            "polite",
            "short"
          ]
        },
        "polarity": {
          "enum": [
            "neg",
            "pos"
          ]
        },
        "tense": {
          "enum": [
            "past",
            "present"
          ]
        },
        "search": {
          "type": "boolean"
        },
        "concept": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "grammar": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    }
  }
}
