{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinloesethjensen/jp-verb-conjugation-app/main/schema/courses.schema.json",
  "title": "Courses",
  "description": "data/courses.json: courses written by teachers and native speakers and approved on the review site. A course holds ids of items in the other data files, never their text. Written by the review site's export; spec docs/superpowers/specs/2026-11-17-courses-data-design.md.",
  "type": "object",
  "required": [
    "version",
    "description",
    "courses",
    "withdrawn"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "courses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/course"
      }
    },
    "withdrawn": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/courseId"
      }
    }
  },
  "$defs": {
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9]{6}$"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z0-9]{6}$"
    },
    "level": {
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1"
      ]
    },
    "author": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "teacher",
            "native",
            "owner"
          ]
        }
      }
    },
    "copiedFrom": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "title",
        "author"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "$ref": "#/$defs/author"
        }
      }
    },
    "follows": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "book"
      ],
      "additionalProperties": false,
      "properties": {
        "book": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "verb",
            "word",
            "grammar",
            "counter",
            "example"
          ]
        },
        "in": {
          "enum": [
            "verbs",
            "grammar",
            "counters"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "title",
        "goal",
        "note",
        "textbook_lesson",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/lessonId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "textbook_lesson": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "course": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "since",
        "title",
        "summary",
        "levels",
        "author",
        "copied_from",
        "follows",
        "lessons"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/courseId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "copied_from": {
          "$ref": "#/$defs/copiedFrom"
        },
        "follows": {
          "$ref": "#/$defs/follows"
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    }
  }
}
