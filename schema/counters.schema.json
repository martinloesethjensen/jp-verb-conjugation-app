{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinloesethjensen/jp-verb-conjugation-app/main/schema/counters.schema.json",
  "title": "Counters",
  "description": "data/counters.json: counters, the groups and sections that organise them. readings, changed and distractors are generated by update_data.py.",
  "type": "object",
  "required": [
    "version",
    "description",
    "counters",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "counters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counter"
      },
      "minItems": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "jlpt": {
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-km-np-z2-9]{6}$"
    },
    "reviewStamp": {
      "type": "object",
      "required": [
        "by",
        "on",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "owner",
            "teacher"
          ]
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "example": {
      "type": "object",
      "required": [
        "id",
        "jp",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "jp": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "readings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[㐀-鿿々〆ヶぁ-ゖ]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[ぁ-ゖー]+$"
          }
        }
      }
    },
    "thing": {
      "type": "object",
      "required": [
        "id",
        "word",
        "kana",
        "meaning",
        "fit"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "word": {
          "type": "string",
          "minLength": 1
        },
        "kana": {
          "type": "string",
          "pattern": "^[ぁ-ゖァ-ヺー]+$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "fit": {
          "enum": [
            "primary",
            "casual",
            "acceptable"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pitfall": {
      "type": "object",
      "required": [
        "id",
        "heading",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "wrong": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "jp",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "jp": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "readings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[㐀-鿿々〆ヶぁ-ゖ]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[ぁ-ゖー]+$"
          }
        }
      }
    },
    "counter": {
      "type": "object",
      "required": [
        "id",
        "counter",
        "reading",
        "meaning",
        "jlpt",
        "sound",
        "symbol",
        "overrides",
        "things",
        "examples",
        "pitfalls",
        "readings",
        "changed",
        "distractors",
        "related"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "counter": {
          "type": "string",
          "minLength": 1
        },
        "reading": {
          "type": "string",
          "pattern": "^[ぁ-ゖー]+$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "jlpt": {
          "$ref": "#/$defs/jlpt"
        },
        "sound": {
          "enum": [
            "h-b",
            "h-p",
            "irregular",
            "k",
            "plain",
            "s"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "overrides": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([0-9]+|what)$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[ぁ-ゖー]+$"
            }
          }
        },
        "things": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/thing"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "pitfalls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pitfall"
          }
        },
        "readings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([0-9]+|what)$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[ぁ-ゖー]+$"
            }
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distractors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([0-9]+|what)$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[ぁ-ゖー]+$"
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "compound": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[ぁ-ゖー]+$"
            }
          }
        },
        "countsObjects": {
          "type": "boolean"
        },
        "extent": {
          "type": "integer",
          "minimum": 10
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "review": {
          "$ref": "#/$defs/reviewStamp"
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "symbol",
        "summary",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "counter",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "counter": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "counters"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "counters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
